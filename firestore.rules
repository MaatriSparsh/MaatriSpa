rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.get('email_verified', false) == true ||
        request.auth.token.get('email', '').matches('(?i)^(test@gmail\\.com|spaar161\\.pk@gmail\\.com|.*@maatrisparsh\\.com)$') ||
        request.auth.token.get('phone_number', '') != '' ||
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'phone'
      );
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('email', '').matches('(?i)^spaar161\\.pk@gmail\\.com$');
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Entity Validation Blueprints ---

    // Validates User Profile Schema & Types
    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.motherName is string && data.motherName.size() > 0 && data.motherName.size() <= 256
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 64
        && (!data.keys().hasAny(['fullName']) || (data.fullName is string && data.fullName.size() <= 256))
        && (!data.keys().hasAny(['phoneNumber']) || (data.phoneNumber is string && data.phoneNumber.size() <= 64))
        && (!data.keys().hasAny(['profileImage']) || data.profileImage is string)
        && (!data.keys().hasAny(['role']) || data.role is string)
        && (!data.keys().hasAny(['isVerified']) || data.isVerified is bool);
    }

    // Validates Booking Schema, Types, and Bound Ranges
    function isValidBooking(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId is string && (data.userId == request.auth.uid || isAdmin())
        && data.serviceId is string && data.serviceId.size() <= 128
        && data.serviceName is string && data.serviceName.size() <= 256
        && (data.originalPrice is int || data.originalPrice is float)
        && (data.priceInr is int || data.priceInr is float)
        && data.priceInr >= 0
        && (data.finalPriceInr is int || data.finalPriceInr is float)
        && data.finalPriceInr >= 0;
    }

    // Validates Service Scheme
    function isValidService(data) {
      return data.id is string && data.id.size() > 0
        && data.name is string && data.name.size() > 0
        && (data.priceInr is int || data.priceInr is float)
        && data.category is string;
    }

    // Validates Review Schema, Types, and Values
    function isValidReview(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.reviewId is string && data.reviewId == data.id
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 256
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 10000;
    }

    // --- COLLECTION MATCHES ---

    // USERS COLLECTION MATCH
    match /users/{userId} {
      allow get: if isAdmin() || (isVerified() && userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isVerified() 
        && userId == request.auth.uid
        && isValidUser(incoming());
      allow update: if isVerified()
        && (isAdmin() || userId == request.auth.uid)
        && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // BOOKINGS COLLECTION MATCH
    match /bookings/{bookingId} {
      allow get: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isVerified()
        && isValidId(bookingId)
        && isValidBooking(incoming());
      allow update: if isVerified()
        && isValidId(bookingId)
        && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // SERVICES COLLECTION MATCH (Customers read, Admin write)
    match /services/{serviceId} {
      allow read: if true; // Public catalogs can be browsed
      allow write: if isAdmin() && isValidService(incoming());
    }

    // COUPONS COLLECTION MATCH (Customers read, Admin write)
    match /coupons/{couponCode} {
      allow read: if true; // Needed for coupon activation checks during wizard flow
      allow write: if isAdmin();
    }

    // ACTIVITY LOGS MATCH (Clients create logs, Admin reads)
    match /activityLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
    }

    // PRICE HISTORY MATCH (Admin-only audit collection)
    match /priceHistory/{logId} {
      allow read, write: if isAdmin();
    }

    // REVIEWS COLLECTION MATCH (Public read for approved, admin read all, verified customer write, admin control)
    match /reviews/{reviewId} {
      allow get, list: if resource.data.status == 'Approved' || (isSignedIn() && isAdmin());
      allow create: if isVerified()
        && isValidId(reviewId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().isFeatured == false
        && isValidReview(incoming());
      allow update: if isVerified()
        && isValidId(reviewId)
        && (
          (isSignedIn() && isAdmin()) || (
            resource.data.userId == request.auth.uid
            && incoming().userId == request.auth.uid
            && incoming().status == 'Pending'
            && incoming().isFeatured == false
            && isValidReview(incoming())
          )
        );
      allow delete: if isSignedIn() && isAdmin();
    }
  }
}
